# Copy this to terraform.tfvars and fill in your API token.
# terraform.tfvars is gitignored — never commit it.
#
# Create a token at: dash.cloudflare.com/profile/api-tokens
# Use "Create Custom Token" with:
#   - Zone > DNS > Edit        (for andreasbogossian.com)
#   - Zone > Zone > Read       (for andreasbogossian.com)
#   - Account > Cloudflare Pages > Edit

cloudflare_api_token  = "your-api-token-here"
cloudflare_account_id = "8db4bf1e04f1e8b7c73fc5c11e0d1216"
cloudflare_zone_id    = "f2bbb1abaa1f3785085825c76fcf59a6"
pages_project_name    = "tech-blog"  # verify this matches your CF Pages project name
