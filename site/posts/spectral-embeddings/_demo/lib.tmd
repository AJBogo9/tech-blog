```{js}
//| name: se
// the few numerical tools the demo needs.
// dense matrices are arrays of Float64Array rows; vectors are Float64Array.

// ---------- random numbers ----------
function rng(seed = 1) {
  // mulberry32
  let a = seed >>> 0;
  const next = () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
  let spare = null;
  next.normal = () => {
    if (spare !== null) { const s = spare; spare = null; return s; }
    let u = 0, v = 0;
    while (u === 0) u = next();
    v = next();
    const r = Math.sqrt(-2 * Math.log(u));
    spare = r * Math.sin(2 * Math.PI * v);
    return r * Math.cos(2 * Math.PI * v);
  };
  next.int = (n) => Math.floor(next() * n);
  next.shuffle = (arr) => {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(next() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  };
  return next;
}

// ---------- small linear algebra ----------
const zeros = (n, m) => Array.from({ length: n }, () => new Float64Array(m));
const dot = (a, b) => { let s = 0; for (let i = 0; i < a.length; i++) s += a[i] * b[i]; return s; };
const norm = (a) => Math.sqrt(dot(a, a));
function copyMat(A) { return A.map((r) => Float64Array.from(r)); }

// symmetric eigendecomposition: Householder tridiagonalisation (tred2) then
// implicit QL (tql2), ported from the public-domain JAMA library.
// returns eigenvalues ascending and eigenvectors as unit vectors.
function eigh(A) {
  const n = A.length;
  const V = copyMat(A), d = new Float64Array(n), e = new Float64Array(n);
  if (n === 1) return { values: Float64Array.of(A[0][0]), vectors: [Float64Array.of(1)] };
  // tred2
  for (let j = 0; j < n; j++) d[j] = V[n - 1][j];
  for (let i = n - 1; i > 0; i--) {
    let scale = 0, h = 0;
    for (let k = 0; k < i; k++) scale += Math.abs(d[k]);
    if (scale === 0) {
      e[i] = d[i - 1];
      for (let j = 0; j < i; j++) { d[j] = V[i - 1][j]; V[i][j] = 0; V[j][i] = 0; }
    } else {
      for (let k = 0; k < i; k++) { d[k] /= scale; h += d[k] * d[k]; }
      let f = d[i - 1];
      let g = Math.sqrt(h);
      if (f > 0) g = -g;
      e[i] = scale * g;
      h -= f * g;
      d[i - 1] = f - g;
      for (let j = 0; j < i; j++) e[j] = 0;
      for (let j = 0; j < i; j++) {
        f = d[j];
        V[j][i] = f;
        g = e[j] + V[j][j] * f;
        for (let k = j + 1; k <= i - 1; k++) { g += V[k][j] * d[k]; e[k] += V[k][j] * f; }
        e[j] = g;
      }
      f = 0;
      for (let j = 0; j < i; j++) { e[j] /= h; f += e[j] * d[j]; }
      const hh = f / (h + h);
      for (let j = 0; j < i; j++) e[j] -= hh * d[j];
      for (let j = 0; j < i; j++) {
        f = d[j]; g = e[j];
        for (let k = j; k <= i - 1; k++) V[k][j] -= f * e[k] + g * d[k];
        d[j] = V[i - 1][j];
        V[i][j] = 0;
      }
    }
    d[i] = h;
  }
  for (let i = 0; i < n - 1; i++) {
    V[n - 1][i] = V[i][i];
    V[i][i] = 1;
    const h = d[i + 1];
    if (h !== 0) {
      for (let k = 0; k <= i; k++) d[k] = V[k][i + 1] / h;
      for (let j = 0; j <= i; j++) {
        let g = 0;
        for (let k = 0; k <= i; k++) g += V[k][i + 1] * V[k][j];
        for (let k = 0; k <= i; k++) V[k][j] -= g * d[k];
      }
    }
    for (let k = 0; k <= i; k++) V[k][i + 1] = 0;
  }
  for (let j = 0; j < n; j++) { d[j] = V[n - 1][j]; V[n - 1][j] = 0; }
  V[n - 1][n - 1] = 1;
  e[0] = 0;
  const Z = zeros(n, n);
  for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) Z[c][r] = V[r][c];
  return tql2(d, e, Z);
}

// implicit QL on a symmetric tridiagonal matrix (diagonal d, subdiagonal in
// e[1..n-1]), rotating the rows of Z. eigenvectors come out as rows of Z.
function tql2(d, e, Z) {
  const n = d.length;
  for (let i = 1; i < n; i++) e[i - 1] = e[i];
  e[n - 1] = 0;
  let f = 0, tst1 = 0;
  const eps = 2 ** -52;
  for (let l = 0; l < n; l++) {
    tst1 = Math.max(tst1, Math.abs(d[l]) + Math.abs(e[l]));
    let m = l;
    while (m < n) { if (Math.abs(e[m]) <= eps * tst1) break; m++; }
    if (m > l) {
      let iter = 0;
      do {
        iter++;
        let g = d[l];
        let p = (d[l + 1] - g) / (2 * e[l]);
        let r = Math.hypot(p, 1);
        if (p < 0) r = -r;
        d[l] = e[l] / (p + r);
        d[l + 1] = e[l] * (p + r);
        const dl1 = d[l + 1];
        let h = g - d[l];
        for (let i = l + 2; i < n; i++) d[i] -= h;
        f += h;
        p = d[m];
        let c = 1, c2 = 1, c3 = 1, s = 0, s2 = 0;
        const el1 = e[l + 1];
        for (let i = m - 1; i >= l; i--) {
          c3 = c2; c2 = c; s2 = s;
          g = c * e[i];
          h = c * p;
          r = Math.hypot(p, e[i]);
          e[i + 1] = s * r;
          s = e[i] / r;
          c = p / r;
          p = c * d[i] - s * g;
          d[i + 1] = h + s * (c * g + s * d[i]);
          const zi = Z[i], zi1 = Z[i + 1];
          for (let k = 0; k < n; k++) {
            h = zi1[k];
            zi1[k] = s * zi[k] + c * h;
            zi[k] = c * zi[k] - s * h;
          }
        }
        p = (-s * s2 * c3 * el1 * e[l]) / dl1;
        e[l] = s * p;
        d[l] = c * p;
      } while (Math.abs(e[l]) > eps * tst1 && iter < 80);
    }
    d[l] += f;
    e[l] = 0;
  }
  const order = Array.from(d.keys()).sort((a, b) => d[a] - d[b]);
  const values = Float64Array.from(order, (i) => d[i]);
  const vectors = order.map((col) => Z[col]);
  return { values, vectors };
}

// sklearn's convention: flip each vector so its largest-magnitude entry is positive.
function signFix(v) {
  let best = 0;
  for (let i = 1; i < v.length; i++) if (Math.abs(v[i]) > Math.abs(v[best])) best = i;
  if (v[best] < 0) for (let i = 0; i < v.length; i++) v[i] = -v[i];
  return v;
}
function rowNormalize(Y) { return Y.map((r) => { const s = Math.hypot(...r) || 1; return r.map((x) => x / s); }); }

// ---------- k-means (k-means++ seeding, several restarts) ----------
function kmeans(X, k, { seed = 3, restarts = 8, iters = 100 } = {}) {
  const r = rng(seed), n = X.length, dimn = X[0].length;
  const d2 = (a, b) => { let s = 0; for (let c = 0; c < dimn; c++) { const t = a[c] - b[c]; s += t * t; } return s; };
  let best = null;
  for (let rep = 0; rep < restarts; rep++) {
    const C = [X[r.int(n)].slice()];
    while (C.length < k) {
      const w = X.map((x) => Math.min(...C.map((c) => d2(x, c))));
      const tot = w.reduce((a, b) => a + b, 0);
      let u = r() * tot, i = 0;
      while (i < n - 1 && (u -= w[i]) > 0) i++;
      C.push(X[i].slice());
    }
    const lab = new Int32Array(n);
    for (let it = 0; it < iters; it++) {
      let moved = false;
      for (let i = 0; i < n; i++) {
        let bj = 0, bd = Infinity;
        for (let j = 0; j < k; j++) { const t = d2(X[i], C[j]); if (t < bd) { bd = t; bj = j; } }
        if (lab[i] !== bj) { moved = true; lab[i] = bj; }
      }
      const S = zeros(k, dimn), cnt = new Int32Array(k);
      for (let i = 0; i < n; i++) { cnt[lab[i]]++; for (let c = 0; c < dimn; c++) S[lab[i]][c] += X[i][c]; }
      for (let j = 0; j < k; j++) if (cnt[j]) for (let c = 0; c < dimn; c++) C[j][c] = S[j][c] / cnt[j];
      if (!moved && it > 0) break;
    }
    let inertia = 0;
    for (let i = 0; i < n; i++) inertia += d2(X[i], C[lab[i]]);
    if (!best || inertia < best.inertia) best = { labels: Array.from(lab), centers: C, inertia };
  }
  return best;
}

// ---------- colours and layout ----------
const cat = ["#4e79a7", "#f28e2b", "#e15759", "#76b7b2", "#59a14f", "#edc948", "#b07aa1", "#ff9da7", "#9c755f", "#bab0ac"];
const WIDTH = 640; // the content column
const width = () => Math.min(WIDTH, (document.documentElement.clientWidth || WIDTH) - 32);

// a matrix or image drawn cell by cell on a canvas. value(i, j) -> colour string.
function heatCanvas(rows, cols, value, { size = 320, title = "" } = {}) {
  const c = document.createElement("canvas");
  const px = Math.max(1, Math.floor(size / Math.max(rows, cols)));
  c.width = cols * px; c.height = rows * px;
  c.style.width = cols * px + "px"; c.style.height = rows * px + "px"; c.style.imageRendering = "pixelated";
  if (title) c.setAttribute("aria-label", title);
  const g = c.getContext("2d");
  for (let i = 0; i < rows; i++) for (let j = 0; j < cols; j++) { g.fillStyle = value(i, j); g.fillRect(j * px, i * px, px, px); }
  return c;
}

return { rng, zeros, dot, norm, eigh, signFix, rowNormalize, kmeans, cat, WIDTH, width, heatCanvas };

```
