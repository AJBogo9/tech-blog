```{js}
//| label: fig-bit-budget
//| input: lpc_order, env_bits, band, earpiece
//| fig-cap: "The bit-budget panel. Grey: the spectrum of one frame of the vowel at the chosen bandwidth. Dashed white: the true envelope of the synthesis filter. Orange: the envelope the decoder rebuilds from your coefficients after rounding. The ledger underneath counts one frame: envelope bits are coefficients times bits per coefficient, the excitation is held at 60 bits, and the total is converted to kilobits per second at 50 frames per second. The envelope error is the root-mean-square gap between the orange and white curves in decibels."
const FORMANTS = tali.defines.vowel_formants;
const F0 = tali.defines.vowel_f0;
const GP = tali.defines.vowel_glottal_pole;
if (!FORMANTS || !F0 || !GP) return;

const p     = tali.value("lpc_order") ?? 16;
const bits  = tali.value("env_bits")  ?? 5;
const bandI = tali.value("band")      ?? 2;
const ear   = tali.value("earpiece")  ?? false;
const fs    = [8000, 12800, 16000][bandI];
const EXC_BITS = 60, FRAME_MS = 20;

// ---- synthesis: identical to the Python cell, at the chosen sampling rate ----
function mulberry32(seed) { return () => { seed |= 0; seed = seed + 0x6D2B79F5 | 0; let t = Math.imul(seed ^ seed >>> 15, 1 | seed); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }
function gauss(rnd) { const u = 1 - rnd(), v = rnd(); return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v); }
function excitation(fs, seconds, seed) {
  const rnd = mulberry32(seed), n = Math.floor(fs * seconds), x = new Float64Array(n);
  for (let i = 0; i < seconds * F0; i++) { const k = Math.round(i * fs / F0); if (k < n) x[k] = 1; }
  for (let i = 0; i < n; i++) x[i] += 0.003 * gauss(rnd);
  const y = new Float64Array(n);
  for (let i = 0; i < n; i++) y[i] = x[i] + (i ? GP * y[i - 1] : 0);
  return y;
}
const inBand = FORMANTS.filter(([F]) => F < 0.47 * fs);
function resonate(y, fs) {
  let out = y;
  for (const [F, B] of inBand) {
    const r = Math.exp(-Math.PI * B / fs), th = 2 * Math.PI * F / fs, a1 = 2 * r * Math.cos(th), a2 = -r * r;
    const z = new Float64Array(out.length);
    for (let i = 0; i < out.length; i++) z[i] = out[i] + (i ? a1 * z[i - 1] : 0) + (i > 1 ? a2 * z[i - 2] : 0);
    out = z;
  }
  return out;
}
function normalise(x) { let m = 0; for (const v of x) m = Math.max(m, Math.abs(v)); const y = new Float64Array(x.length); for (let i = 0; i < x.length; i++) y[i] = x[i] / m; return y; }
const SECONDS = 0.7;
const exc = excitation(fs, SECONDS, 0);
const vowel = normalise(resonate(exc, fs));

// ---- analysis frame ----
const L = Math.floor(0.032 * fs), n0 = Math.floor(0.25 * fs);
const frame = new Float64Array(L);
for (let i = 0; i < L; i++) frame[i] = vowel[n0 + i] * (0.54 - 0.46 * Math.cos(2 * Math.PI * i / (L - 1)));

// ---- Levinson-Durbin, same as the Python listing ----
function lpc(frame, order) {
  const r = new Float64Array(order + 1);
  for (let k = 0; k <= order; k++) { let s = 0; for (let i = k; i < frame.length; i++) s += frame[i] * frame[i - k]; r[k] = s; }
  let a = [1], err = r[0]; const refl = [];
  for (let i = 1; i <= order; i++) {
    let acc = r[i]; for (let j = 1; j < i; j++) acc += a[j] * r[i - j];
    const k = -acc / err;
    const na = a.slice(); na.push(0);
    for (let j = 1; j <= i; j++) na[j] += k * a[i - j];
    a = na; err *= 1 - k * k; refl.push(k);
  }
  return { a, refl };
}
// reflection coefficients -> A(z) (step-up), so we can rebuild the filter from quantised values
function stepUp(refl) {
  let a = [1];
  for (let i = 1; i <= refl.length; i++) {
    const k = refl[i - 1], na = a.slice(); na.push(0);
    for (let j = 1; j <= i; j++) na[j] += k * a[i - j];
    a = na;
  }
  return a;
}
// uniform mid-rise quantiser on arcsine(reflection coefficient), `bits` bits each
function quantise(refl, bits) {
  const levels = 2 ** bits, step = Math.PI / levels;
  return refl.map(k => {
    const s = Math.asin(Math.max(-0.999999, Math.min(0.999999, k)));
    const q = Math.max(0, Math.min(levels - 1, Math.floor((s + Math.PI / 2) / step)));
    return Math.sin(-Math.PI / 2 + (q + 0.5) * step) * 0.999;
  });
}
const { refl } = lpc(frame, p);
const aq = stepUp(quantise(refl, bits));

// ---- spectra ----
const NF = 512;
const freqs = Array.from({ length: NF }, (_, i) => i * (fs / 2) / (NF - 1));
function envelopeDb(a, fs) {
  return freqs.map(f => { const w = 2 * Math.PI * f / fs; let re = 0, im = 0;
    for (let k = 0; k < a.length; k++) { re += a[k] * Math.cos(-w * k); im += a[k] * Math.sin(-w * k); }
    return -20 * Math.log10(Math.hypot(re, im) + 1e-12); });
}
function trueDb(fs) {
  return freqs.map(f => { const w = 2 * Math.PI * f / fs;
    let mag = 1 / Math.hypot(1 - GP * Math.cos(w), GP * Math.sin(w));
    for (const [F, B] of inBand) { const r = Math.exp(-Math.PI * B / fs), th = 2 * Math.PI * F / fs;
      const c1 = 2 * r * Math.cos(th), c2 = r * r;
      mag /= Math.hypot(1 - c1 * Math.cos(w) + c2 * Math.cos(2 * w), c1 * Math.sin(w) - c2 * Math.sin(2 * w)); }
    return 20 * Math.log10(mag); });
}
function fft(re, im) { // in-place radix-2
  const n = re.length;
  for (let i = 1, j = 0; i < n; i++) { let bit = n >> 1; for (; j & bit; bit >>= 1) j ^= bit; j ^= bit;
    if (i < j) { [re[i], re[j]] = [re[j], re[i]]; [im[i], im[j]] = [im[j], im[i]]; } }
  for (let len = 2; len <= n; len <<= 1) { const ang = -2 * Math.PI / len, wr = Math.cos(ang), wi = Math.sin(ang);
    for (let i = 0; i < n; i += len) { let cr = 1, ci = 0;
      for (let j = 0; j < len / 2; j++) { const ur = re[i + j], ui = im[i + j];
        const vr = re[i + j + len / 2] * cr - im[i + j + len / 2] * ci, vi = re[i + j + len / 2] * ci + im[i + j + len / 2] * cr;
        re[i + j] = ur + vr; im[i + j] = ui + vi; re[i + j + len / 2] = ur - vr; im[i + j + len / 2] = ui - vi;
        const ncr = cr * wr - ci * wi; ci = cr * wi + ci * wr; cr = ncr; } } }
}
const NFFT = 2048, re = new Float64Array(NFFT), im = new Float64Array(NFFT);
re.set(frame); fft(re, im);
const specDb = freqs.map(f => { const b = Math.min(NFFT / 2, Math.round(f / fs * NFFT)); return 20 * Math.log10(Math.hypot(re[b], im[b]) + 1e-9); });

const T = trueDb(fs), Q = envelopeDb(aq, fs);
const mean = v => v.reduce((s, x) => s + x, 0) / v.length;
const specMax = Math.max(...specDb);
const Tn = T.map(v => v - Math.max(...T));
const off = mean(Tn) - mean(Q);
const Qn = Q.map(v => v + off);
const err = Math.sqrt(mean(Qn.map((v, i) => (v - Tn[i]) ** 2)));

// ---- ledger ----
const envBits = p * bits, total = envBits + EXC_BITS, kbps = total * (1000 / FRAME_MS) / 1000;

// ---- draw ----
const W = 680, H = 300, m = { l: 48, r: 16, t: 16, b: 36 };
const xs = d3.scaleLinear([0, fs / 2], [m.l, W - m.r]);
const ys = d3.scaleLinear([-70, 5], [H - m.b, m.t]);
const svg = d3.create("svg").attr("viewBox", `0 0 ${W} ${H}`).style("max-width", "100%").style("height", "auto")
  .style("background", "#111827").style("border-radius", "8px 8px 0 0");
const line = d3.line().x((d, i) => xs(freqs[i])).y(d => ys(Math.max(-70, d)));
svg.append("g").attr("transform", `translate(0,${H - m.b})`).call(d3.axisBottom(xs).ticks(8).tickFormat(d => d3.format(",")(d)))
  .call(g => g.selectAll("text").style("fill", "#9ca3af").style("font-size", "10px")).call(g => g.selectAll("line,path").style("stroke", "#4b5563"));
svg.append("g").attr("transform", `translate(${m.l},0)`).call(d3.axisLeft(ys).ticks(5))
  .call(g => g.selectAll("text").style("fill", "#9ca3af").style("font-size", "10px")).call(g => g.selectAll("line,path").style("stroke", "#4b5563"));
svg.append("text").attr("x", W / 2).attr("y", H - 6).attr("text-anchor", "middle").style("fill", "#9ca3af").style("font-size", "10px").text("frequency (Hz)");
svg.append("text").attr("transform", `translate(12,${H / 2}) rotate(-90)`).attr("text-anchor", "middle").style("fill", "#9ca3af").style("font-size", "10px").text("dB");
svg.append("path").datum(specDb.map(v => v - specMax)).attr("d", line).attr("fill", "none").attr("stroke", "#6b7280").attr("stroke-width", 0.8);
svg.append("path").datum(Tn).attr("d", line).attr("fill", "none").attr("stroke", "white").attr("stroke-width", 1.2).attr("stroke-dasharray", "5,4").attr("opacity", 0.8);
svg.append("path").datum(Qn).attr("d", line).attr("fill", "none").attr("stroke", "#f0956a").attr("stroke-width", 2.2);
svg.append("text").attr("x", W - m.r - 6).attr("y", m.t + 14).attr("text-anchor", "end").style("fill", "#f0956a").style("font-size", "12px")
  .text(`envelope error ${err.toFixed(1)} dB`);
svg.append("text").attr("x", W - m.r - 6).attr("y", m.t + 30).attr("text-anchor", "end").style("fill", "#9ca3af").style("font-size", "11px")
  .text(`${inBand.length} of ${FORMANTS.length} formants inside the band`);

const ledger = document.createElement("div");
ledger.style.cssText = "background:#1f2937;border-radius:0 0 8px 8px;padding:10px 14px;font-size:13px;color:#d1d5db;display:grid;grid-template-columns:1fr auto;gap:2px 16px;";
const rows = [["Envelope: " + p + " coefficients x " + bits + " bits", envBits + " bits"],
              ["Excitation (pitch, energy, voicing), held fixed", EXC_BITS + " bits"],
              ["Per 20 ms frame", total + " bits"],
              ["Bitrate at 50 frames per second", kbps.toFixed(2) + " kbit/s"]];
for (const [k, v] of rows) { const a = document.createElement("span"); a.textContent = k; const b = document.createElement("span"); b.textContent = v; b.style.cssText = "text-align:right;color:#f0956a;font-variant-numeric:tabular-nums;"; ledger.append(a, b); }

// ---- audio ----
function resynth(a, fs) {
  const e = excitation(fs, SECONDS, 0), y = new Float64Array(e.length);
  for (let i = 0; i < e.length; i++) { let s = e[i]; for (let k = 1; k < a.length && k <= i; k++) s -= a[k] * y[i - k]; y[i] = s; }
  return normalise(y);
}
function play(samples, fs, earpiece) {
  const store = tali.get("bitbudget_audio") || {};
  if (!store.ctx) { store.ctx = new (window.AudioContext || window.webkitAudioContext)(); tali.set("bitbudget_audio", store); }
  const ctx = store.ctx; if (ctx.state === "suspended") ctx.resume();
  const buf = ctx.createBuffer(1, samples.length, fs), ch = buf.getChannelData(0);
  const fade = Math.floor(0.01 * fs);
  for (let i = 0; i < samples.length; i++) { let g = 0.4; if (i < fade) g *= i / fade; if (i > samples.length - fade) g *= (samples.length - i) / fade; ch[i] = samples[i] * g; }
  const src = ctx.createBufferSource(); src.buffer = buf;
  let node = src;
  if (earpiece) { const hp = ctx.createBiquadFilter(); hp.type = "highpass"; hp.frequency.value = 300;
    const lp = ctx.createBiquadFilter(); lp.type = "lowpass"; lp.frequency.value = 3400; lp.Q.value = 0.7;
    const lp2 = ctx.createBiquadFilter(); lp2.type = "lowpass"; lp2.frequency.value = 3400; lp2.Q.value = 0.7;
    src.connect(hp); hp.connect(lp); lp.connect(lp2); node = lp2; }
  node.connect(ctx.destination); src.start();
}
const btnRow = document.createElement("div");
btnRow.style.cssText = "display:flex;gap:8px;margin-top:8px;";
const mk = (label, fn) => { const b = document.createElement("button"); b.textContent = label; b.className = "tali-input";
  b.style.cssText = "cursor:pointer;padding:4px 12px;border-radius:6px;border:1px solid #4b5563;background:#374151;color:#EAE7E0;font-size:13px;"; b.onclick = fn; return b; };
btnRow.append(mk("Play original", () => play(vowel, fs, ear)), mk("Play coded", () => play(resynth(aq, fs), fs, ear)));

const root = document.createElement("div");
root.append(svg.node(), ledger, btnRow);
return root;
```

At the starting setting (8 kHz, 16 coefficients, 5 bits) the error is about 3 dB. The orange curve has only seven bumps for eight formants: it merges the two highest into one, and the bumps above 2 kHz come out too flat. Move to 18 coefficients and the error drops to about 1 dB, and every formant gets its own bump. Keep going to 40 and the fit does not improve. The error slowly rises to about 1.7 dB while the envelope costs more than twice as much, 200 bits instead of 90. The extra coefficients start fitting single harmonics of the excitation, which is detail the envelope should not contain.

Now switch to 4 kHz. Only four formants are left inside the band, and the error drops at 10 coefficients instead of 18.

The bits per coefficient matter as much as the count. At 2 or 3 bits, adding coefficients makes the envelope worse, since each coefficient adds its own rounding error. From 5 bits up, 18 coefficients stay close to the true envelope.

Last, turn on the earpiece and compare 4 kHz with 8 kHz by ear. The earpiece cuts everything above 3.4 kHz, so on that handset the bits spent above 4 kHz buy little that you can hear.

## Three real ledgers

The panel spends most of its bits on the envelope. Real codecs do not agree on that split. AMR-WB, the codec behind the "HD Voice" label on most 3G and 4G calls, packs each 20 ms of speech into 253 bits at its most common rate, 12.65 kbit/s [@tgpp_amrwb]:

| Row | What it describes | Bits per 20 ms frame |
|---|---|---:|
| Spectral envelope (16 immittance spectral pairs) | the shape of the vocal tract | 46 |
| Pitch lag | where in the recent past the excitation repeats | 30 |
| Pitch filter flag | whether to smooth the repeated excitation | 4 |
| Algebraic codebook | which pulses to add to the repeated excitation | 144 |
| Gains | how loud each part is | 28 |
| Voice activity flag | is anyone speaking | 1 |
| **Total** | | **253** |

The first row is the envelope: 16 coefficients in 46 bits, under three bits each. The panel could not get a good fit at that price, and the next section explains how AMR-WB does. The other 207 bits describe the excitation. AMR-WB does not send the excitation sample by sample. It sends the **pitch lag**, a pointer that says the excitation now looks like the excitation one pitch period ago, and then a few correcting pulses from the **algebraic codebook**, chosen so that the decoded waveform matches the original as closely as the bits allow. Those pulses are the largest row, 144 of the 253 bits. So AMR-WB spends 18 percent of the frame on the shape of the vocal tract and most of the rest on matching the waveform.

Codec 2, David Rowe's open codec used for digital voice on amateur radio, makes the opposite choice. In its 3200 bit/s mode it spends 50 of its 64 bits per frame on the envelope and describes the excitation with a pitch, an energy and two voicing bits [@rowe_codec2]. It does not try to match the waveform, only to sound like the same vowel from the same voice, and it runs at a quarter of AMR-WB's rate. The panel above is built the same way as Codec 2. @fig-bit-ledger puts the ledgers side by side.

```{python}
#| label: fig-bit-ledger
#| fig-cap: "Three bit ledgers, in bits per 20 ms of speech. Codec 2 at 3200 bit/s spends most of its frame on the envelope. AMR-WB at 12.65 kbit/s spends most of its frame on the excitation, mainly the algebraic codebook pulses that make the decoded waveform match the original. EnCodec at 12 kbit/s uses about as many bits per frame as AMR-WB, spread over 16 learned codebooks with no documented meaning, so its bar has no rows."
#| echo: false
ledgers = [
    ("EnCodec 12 kbit/s",   [("learned codes (16 codebooks x 10 bits x 1.5 frames)", 240, "#4b5563")]),
    ("AMR-WB 12.65 kbit/s", [("envelope (ISP)", 46, ORANGE), ("pitch lag", 30, BLUE), ("pitch filter", 4, "#5b9bd5"),
                             ("algebraic codebook", 144, GREEN), ("gains", 28, PURPLE), ("VAD", 1, GREY)]),
    ("Codec 2 3200 bit/s",  [("envelope (LSP)", 50, ORANGE), ("pitch", 7, BLUE), ("energy", 5, PURPLE), ("voicing", 2, GREY)]),
]
fig, ax = plt.subplots(figsize=(10, 3.6), tight_layout=True)
for yi, (name, rows) in enumerate(ledgers):
    left = 0
    for label, bits, colour in rows:
        ax.barh(yi, bits, left=left, color=colour, edgecolor="#111827", height=0.6)
        if bits >= 20:
            ax.text(left + bits / 2, yi, f"{label}\n{bits}", ha="center", va="center", fontsize=8.5, color="#111827")
        left += bits
    ax.text(left + 4, yi, f"{left} bits", va="center", color="white", fontsize=10)
ax.set_yticks(range(len(ledgers))); ax.set_yticklabels([n for n, _ in ledgers])
ax.set_xlabel("bits per 20 ms frame"); ax.set_xlim(0, 300); ax.grid(axis="y", visible=False)
plt.show()
```

The grey bar is EnCodec, a neural codec from Meta [@defossez2022]. A neural codec replaces the whole pipeline with learned parts. An encoder network turns 24 kHz audio into 75 vectors per second, a stack of vector quantisers replaces each vector with indices into learned codebooks, and a decoder network turns the indices back into audio. The bitrate follows from the stack: 75 frames per second, times the number of codebooks, times 10 bits for a codebook with 1024 entries. Sixteen codebooks give 12 kbit/s and two give 1.5 kbit/s. SoundStream introduced the design [@zeghidour2021], the Descript Audio Codec extended it to 44.1 kHz audio [@kumar2023], and Mimi, the codec inside the Moshi dialogue model, runs at 12.5 frames per second so that a language model has fewer tokens to predict [@defossez2024].

These codecs still code vowels that have an envelope and an excitation. But each quantiser in the stack codes what the ones before it missed, and the split between envelope and excitation is whatever training found. Nobody wrote it down, so there is no table like AMR-WB's to read.

# Linear prediction

::: {.callout-note collapse="true"}
## Notation used in this section

| Symbol | Meaning |
|--------|---------|
| $x[n]$ | the $n$-th sample of the speech frame |
| $p$ | number of coefficients per frame (the first slider) |
| $a_k$ | the $k$-th prediction coefficient, $k = 1, \ldots, p$ |
| $\hat{x}[n]$ | the prediction of $x[n]$ from the previous $p$ samples |
| $e[n]$ | the prediction error, or residual |
| $A(z)$ | the prediction error filter, $1 + \sum_k a_k z^{-k}$ |
| $\omega$ | frequency in radians per sample |
:::

The panel never sees the vocal tract, only samples. It finds the envelope with **linear prediction**: predict each sample as a weighted sum of the previous $p$ samples,

$$
\hat{x}[n] = -\sum_{k=1}^{p} a_k\, x[n-k], \qquad e[n] = x[n] - \hat{x}[n],
$$

and choose the weights $a_k$ that make the prediction error $e[n]$ as small as possible over the frame [@makhoul1975]. $p$ is the first slider. With $A(z) = 1 + \sum_k a_k z^{-k}$, the orange curve in the panel is $1/|A(e^{j\omega})|$, and $e[n]$ is what is left of the vowel once the envelope is removed, which is an estimate of the excitation. So one least-squares fit separates the two parts of @fig-source-filter: the weights describe the tract and the residual describes the pulses.

In machine learning terms this is an autoregressive model of order $p$, the AR($p$) model from time series, fitted by least squares. WaveNet also predicts each sample from the samples before it, with a neural network in place of the $p$ weights [@oord2016].

::: {.callout-note collapse="true"}
## Levinson-Durbin in Python

The weights solve a small linear system built from the frame's autocorrelation. The Levinson-Durbin recursion solves it in $O(p^2)$ operations and produces the reflection coefficients that the panel rounds along the way. The panel runs a JavaScript copy of this function.

```python
def lpc(frame, order):
    """Levinson-Durbin. Returns the coefficients of A(z) = 1 + a1 z^-1 + ... + ap z^-p
    and the reflection coefficients found along the way."""
    r = np.correlate(frame, frame, "full")[len(frame) - 1:len(frame) + order]
    a, err, refl = np.array([1.0]), r[0], []
    for i in range(1, order + 1):
        k = -(r[i] + a[1:] @ r[i - 1:0:-1]) / err       # next reflection coefficient
        a = np.concatenate([a, [0.0]]) + k * np.concatenate([[0.0], a[::-1]])
        err *= 1 - k * k
        refl.append(k)
    return a, np.array(refl)
```
:::

The error dropped at 18 coefficients because each formant is a resonance, and a resonance needs a pair of poles in $1/A(z)$, which costs two coefficients. The synthetic vowel has eight formants below 8 kHz plus one extra pole for the downward tilt of the excitation, so it needs 17 coefficients, and 18 is the first slider setting that covers them. At 4 kHz four formants remain, which needs 9, so the drop comes at 10. Real speech has roughly one formant per kilohertz of bandwidth plus a few poles for the shape of the glottal pulse, which is why 16 kHz speech is usually analysed with 18 to 20 coefficients [@markel_gray1976] and why AMR-WB uses 16 for its 6.4 kHz band.

Past that count, extra coefficients hurt. The fit has more poles than there are formants, so it spends the spare ones on the strongest harmonics of the excitation. That is the slow rise in the error after 18 coefficients.

The bits slider does not round the $a_k$ themselves. A small rounding error in one $a_k$ moves the whole envelope, and a slightly larger one can push a pole outside the unit circle, where the decoder's filter becomes unstable and its output grows without bound. The panel rounds the reflection coefficients from the recursion instead, after an arcsine warp, and the filter stays stable as long as each of them stays between $-1$ and $1$. Rounding one coefficient at a time is still wasteful: at the 6.4 kHz band, 16 coefficients need 6 bits each, 96 bits in total, to bring the panel's error near 1 dB.

Standards do better in two steps. First they convert the coefficients into **line spectral frequencies**, the resonance positions written as a sorted list of frequencies, where each value moves the envelope only near its own frequency. AMR-WB uses a close relative called immittance spectral pairs. Then they round the values jointly with a vector quantiser. Paliwal and Atal kept the average envelope error near 1 dB, the level the field treats as transparent, at 24 bits per frame for 10 coefficients [@paliwal_atal1993]. The same approach is how AMR-WB fits its 16 coefficients into 46 bits.

# Summary

- A vowel is a train of pulses (the excitation) shaped by the vocal tract (the envelope), and a codec can pay for the two separately.
- The envelope needs about two coefficients per formant. Past that, extra coefficients fit harmonics of the excitation, and the error rises while the bit count grows.
- How the coefficients are rounded matters as much as how many there are. Standards round line spectral frequencies jointly, which fits AMR-WB's envelope into 46 of its 253 bits.
- AMR-WB spends most of its frame matching the waveform. Codec 2 spends most of its frame on the envelope and runs at a quarter of the rate.
- Neural codecs such as EnCodec split their bits too, but training chooses the split and nothing documents it. Measuring that split in a way that is fair to both kinds of codec is the subject of the next post.
