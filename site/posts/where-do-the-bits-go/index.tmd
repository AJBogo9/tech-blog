wrap.className = "tali-input";
wrap.append("LPC order (coefficients per frame) ");
const input = document.createElement("input");
input.type = "range"; input.min = "2"; input.max = "40"; input.step = "2"; input.value = "16";
wrap.append(input);
return wrap;
```

